load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

cuda_library(
    name = "reduction",
    srcs = ["reduction.cu"],
    hdrs = ["reduction.h"],
    copts = select({
        "//:windows": ["-std=c++20"],
        "//conditions:default": ["-std=c++26"],
    }),
    defines = ["_ALLOW_UNSUPPORTED_LIBCPP"],
    deps = ["@cuda//:cuda_runtime"],
)

cc_test(
    name = "reduction_test",
    srcs = ["reduction_test.cc"],
    deps = [":reduction"],
)

cc_binary(
    name = "reduction_benchmark",
    srcs = ["reduction_benchmark.cc"],
    deps = [":reduction"],
)
