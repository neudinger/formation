load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

package(default_visibility = ["//visibility:public"])

CUDA_COPTS = select({
    "//:windows": ["-std=c++20"],
    "//conditions:default": ["-std=c++26"],
})

cc_library(
    name = "runtime",
    srcs = ["cuda_runtime_helpers.cc"],
    hdrs = ["cuda_runtime_helpers.h"],
    deps = ["@cuda//:cuda_runtime"],
)

cc_library(
    name = "matmul_cpu",
    srcs = ["matmul_cpu.cc"],
    hdrs = ["matmul_cpu.h"],
)

cuda_library(
    name = "matmul_basic_device",
    srcs = ["matmul_basic_device.cu"],
    hdrs = [
        "matmul_basic.h",
        "matmul_basic_device.h",
    ],
    copts = CUDA_COPTS,
    defines = ["_ALLOW_UNSUPPORTED_LIBCPP"],
    deps = [":runtime"],
)

cc_library(
    name = "matmul_basic",
    srcs = ["matmul_basic_cuda.cc"],
    hdrs = ["matmul_basic.h"],
    deps = [
        ":matmul_basic_device",
        ":runtime",
        "@cuda//:cuda_runtime",
    ],
)

cuda_library(
    name = "matmul_tiled_device",
    srcs = ["matmul_tiled_device.cu"],
    hdrs = [
        "matmul_tiled.h",
        "matmul_tiled_device.h",
    ],
    copts = CUDA_COPTS,
    defines = ["_ALLOW_UNSUPPORTED_LIBCPP"],
    deps = [":runtime"],
)

cc_library(
    name = "matmul_tiled",
    srcs = ["matmul_tiled_cuda.cc"],
    hdrs = ["matmul_tiled.h"],
    deps = [
        ":matmul_tiled_device",
        ":runtime",
        "@cuda//:cuda_runtime",
    ],
)

cc_library(
    name = "matmul_cublas",
    srcs = ["matmul_cublas.cc"],
    hdrs = ["matmul_cublas.h"],
    linkopts = select({
        "//:windows": [],
        "//conditions:default": ["-ldl"],
    }),
    deps = [
        ":runtime",
        "@cuda//:cublas",
        "@cuda//:cuda_runtime",
    ],
)

cc_test(
    name = "matmul_cublas_test",
    srcs = ["matmul_cublas_test.cc"],
    deps = [":matmul_cublas"],
)

cc_test(
    name = "matmul_test",
    srcs = ["matmul_test.cc"],
    deps = [
        ":matmul_basic",
        ":matmul_cpu",
        ":matmul_tiled",
    ],
)

cc_binary(
    name = "matmul_benchmark",
    srcs = ["matmul_benchmark.cc"],
    deps = [
        ":matmul_basic",
        ":matmul_cpu",
        ":matmul_tiled",
        ":matmul_cublas",
    ],
)
