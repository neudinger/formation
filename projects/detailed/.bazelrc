common --enable_bzlmod

# Keep compiler selection inside Bazel. Do not point CC/CXX at host paths.
build --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux

# Make rules_cuda's Clang CUDA toolchain reuse the selected cc_toolchain.
build --repo_env=CUDA_COMPILER_USE_CC_TOOLCHAIN=true
build --@rules_cuda//cuda:compiler=clang
build --@rules_cuda//cuda:archs=compute_86:compute_86,sm_86

build --cxxopt=-std=c++26
build --host_cxxopt=-std=c++26

test --test_output=errors
run --enable_bzlmod
