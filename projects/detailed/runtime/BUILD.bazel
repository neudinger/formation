load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "cuda_errors",
    hdrs = ["cuda_errors.h"],
    deps = ["@cuda//:cuda_runtime"],
)

cc_library(
    name = "cuda_launch",
    hdrs = ["cuda_launch.h"],
    deps = [
        ":cuda_errors",
        "@cuda//:cuda_runtime",
    ],
)

cc_binary(
    name = "device_info",
    srcs = ["device_info.cc"],
    deps = [
        ":cuda_errors",
        "@cuda//:cuda_runtime",
    ],
)
